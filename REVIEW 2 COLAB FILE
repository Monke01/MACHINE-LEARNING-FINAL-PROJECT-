        "forecast = forecast_df.copy()\n",
        "target = \"Next Heart Rate (bpm)\"\n",
        "if target not in forecast.columns:\n",
        "    raise ValueError(f\"Target column '{target}' not found in Forecast_Ready.\")\n",
        "\n",
        "if \"Patient_ID\" not in forecast.columns:\n",
        "    raise ValueError(\"Patient_ID is required for patient-wise train/test splitting.\")\n",
        "\n",
        "# Determine train/test rows from Patient_Split if possible.\n",
        "if \"Patient_Split\" in forecast.columns:\n",
        "    split_values = forecast[\"Patient_Split\"].astype(str).str.lower().str.strip()\n",
        "    train_mask = split_values.isin([\"train\", \"training\"])\n",
        "    test_mask = split_values.isin([\"test\", \"testing\"])\n",
        "else:\n",
        "    train_mask = pd.Series(False, index=forecast.index)\n",
        "    test_mask = pd.Series(False, index=forecast.index)\n",
        "\n",
        "if not train_mask.any() or not test_mask.any():\n",
        "    patients = forecast[\"Patient_ID\"].dropna().unique()\n",
        "    rng = np.random.default_rng(RANDOM_STATE)\n",
        "    rng.shuffle(patients)\n",
        "    cut = max(1, int(0.8 * len(patients)))\n",
        "    train_patients, test_patients = set(patients[:cut]), set(patients[cut:])\n",
        "    train_mask = forecast[\"Patient_ID\"].isin(train_patients)\n",
        "    test_mask = forecast[\"Patient_ID\"].isin(test_patients)\n",
        "\n",
        "train_df = forecast.loc[train_mask].copy()\n",
        "test_df = forecast.loc[test_mask].copy()\n",
        "if train_df.empty or test_df.empty:\n",
        "    raise ValueError(\"Train/test split is empty. Check Patient_Split and Patient_ID values.\")\n",
        "\n",
        "excluded = [\n",
        "    target, \"Patient_ID\", \"Timestamp_HHMM\", \"Next Reading Time (HH:MM)\",\n",
        "    \"Patient_Split\"\n",
        "]\n",
        "# Exclude other columns whose names indicate future/target-derived information.\n",
        "excluded += [\n",
        "    c for c in forecast.columns\n",
        "    if c != target and any(term in c.lower() for term in\n",
        "                           [\"next_\", \"next \", \"future\", \"target\", \"lead_\"])\n",
        "]\n",
        "predictor_cols = [\n",
        "    c for c in forecast.columns\n",
        "    if c not in set(excluded) and pd.api.types.is_numeric_dtype(forecast[c])\n",
        "]\n",
        "\n",
        "if not predictor_cols:\n",
        "    raise ValueError(\"No numeric predictor columns remain after leakage exclusions.\")\n",
        "\n",
        "X_train = train_df[predictor_cols]\n",
        "X_test = test_df[predictor_cols]\n",
        "y_train = pd.to_numeric(train_df[target], errors=\"coerce\")\n",
        "y_test = pd.to_numeric(test_df[target], errors=\"coerce\")\n",
        "\n",
        "train_valid = y_train.notna()\n",
        "test_valid = y_test.notna()\n",
        "X_train, y_train = X_train.loc[train_valid], y_train.loc[train_valid]\n",
        "X_test, y_test = X_test.loc[test_valid], y_test.loc[test_valid]\n",
        "\n",
        "if X_train.empty or X_test.empty:\n",
        "    raise ValueError(\"No valid target values in train or test set.\")\n",
        "\n",
        "# Leakage check: no patient may appear in both sets.\n",
        "overlap = set(train_df[\"Patient_ID\"].dropna()) & set(test_df[\"Patient_ID\"].dropna())\n",
        "if overlap:\n",
        "    raise ValueError(f\"Patient leakage detected: {len(overlap)} patients in both sets.\")\n",
        "\n",
        "print(\"Train rows:\", len(X_train), \"| Test rows:\", len(X_test))\n",
        "print(\"Train patients:\", train_df[\"Patient_ID\"].nunique(),\n",
        "      \"| Test patients:\", test_df[\"Patient_ID\"].nunique())\n",
        "print(\"Predictors:\", predictor_cols)"
