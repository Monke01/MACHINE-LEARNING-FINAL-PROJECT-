        "# Use numeric clinical columns, excluding identifiers and time.\n",
        "hmm_exclude = [\"Patient_ID\", \"Time_Minutes\"]\n",
        "hmm_features = seq.drop(columns=[c for c in hmm_exclude if c in seq.columns])\n",
        "hmm_features = hmm_features.select_dtypes(include=np.number)\n",
        "\n",
        "if hmm_features.shape[1] == 0:\n",
        "    raise ValueError(\"No numeric clinical features available for the HMM.\")\n",
        "\n",
        "# Drop columns that contain no usable values, then median-impute.\n",
        "hmm_features = hmm_features.dropna(axis=1, how=\"all\")\n",
        "hmm_imputer = SimpleImputer(strategy=\"median\")\n",
        "X_hmm = hmm_imputer.fit_transform(hmm_features)\n",
        "hmm_scaler = StandardScaler()\n",
        "X_hmm = hmm_scaler.fit_transform(X_hmm)\n",
        "\n",
        "sequence_lengths = seq.groupby(\"Patient_ID\", sort=False).size().tolist()\n",
